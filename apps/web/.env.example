# 会場LAN内のTURN(coturn)の設定。**実際の credential はコミットしない。**
# このファイルをコピーして `.env.local` を作り、そちらへ実値を書く(.gitignore 済み)。
#
# 3つとも空ならTURNは無効で、これまでどおり direct(host candidate)だけを使う。
# 一部だけ設定すると起動時に設定エラーで落ちる — 「入れたつもりで効いていない」まま
# 実機検証しないようにするため。
#
# 外部のSTUN/TURNサービスは使わない(AGENTS.md 前提6)。指すのは会場LAN内のホスト。

VITE_TURN_URLS=turn:192.168.1.146:3478?transport=udp,turn:192.168.1.146:3478?transport=tcp
VITE_TURN_USERNAME=dip
VITE_TURN_CREDENTIAL=REPLACE_ME_LOCAL_ONLY

# 検証専用。1 にすると iceTransportPolicy を relay へ固定し、中継経路だけを試せる。
# **本番では必ず 0(または未設定)。** direct で足りる環境まで中継を通ることになる。
VITE_FORCE_RELAY=0
