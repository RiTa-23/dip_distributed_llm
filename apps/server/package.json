{
  "name": "@dip_distributed_llm/server",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "cert": "bash scripts/gen-cert.sh",
    "dummy-model": "bash scripts/gen-dummy-model.sh",
    "web:copy": "bun run --cwd ../web build && rm -rf public/web-dist && cp -r ../web/dist public/web-dist && touch public/web-dist/.gitkeep",
    "setup": "bun run cert && bun run dummy-model && bun run web:copy",
    "lint": "oxlint",
    "format": "oxfmt --check src",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dip_distributed_llm/shared-types": "workspace:*",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}