{
  "name": "@dip_distributed_llm/server",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "cert": "bun scripts/gen-cert.ts",
    "dns": "bun scripts/update-dns.ts",
    "venue": "bun scripts/venue.ts",
    "dummy-model": "bun scripts/gen-dummy-model.ts",
    "web:copy": "bun run --cwd ../web build && bun scripts/copy-web-dist.ts",
    "setup": "bun run cert && bun run web:copy",
    "lint": "oxlint",
    "format": "oxfmt --check src",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dip_distributed_llm/shared-types": "workspace:*",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
